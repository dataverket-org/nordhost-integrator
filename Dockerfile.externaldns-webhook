# Build on the native (host) platform and cross-compile - Go handles that
# natively via GOOS/GOARCH, avoiding QEMU emulation for the build itself
# (which is what --platform=$TARGETPLATFORM here would otherwise trigger).
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build_deps

RUN apk add --no-cache git

WORKDIR /workspace

COPY go.mod .
COPY go.sum .

RUN go mod download

FROM build_deps AS build

ARG TARGETOS
ARG TARGETARCH

COPY . .

RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o externaldns-webhook -ldflags '-w -extldflags "-static"' ./cmd/externaldns-webhook

FROM alpine:3.22

RUN apk add --no-cache ca-certificates && \
    adduser -D -u 65532 nonroot

COPY --from=build /workspace/externaldns-webhook /usr/local/bin/externaldns-webhook

# Numeric UID, not the username - Kubernetes' runAsNonRoot check can only
# statically verify a numeric USER without actually running the container.
USER 65532

ENTRYPOINT ["externaldns-webhook"]
