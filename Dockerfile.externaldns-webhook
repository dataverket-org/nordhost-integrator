FROM golang:1.27-alpine AS build_deps

RUN apk add --no-cache git

WORKDIR /workspace

COPY go.mod .
COPY go.sum .

RUN go mod download

FROM build_deps AS build

COPY . .

RUN CGO_ENABLED=0 go build -o externaldns-webhook -ldflags '-w -extldflags "-static"' ./cmd/externaldns-webhook

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=build /workspace/externaldns-webhook /usr/local/bin/externaldns-webhook

ENTRYPOINT ["externaldns-webhook"]
